new file mode 100644
index 0000000..b683d72
--- /dev/null
+++ b/coordinator/api/app/routers/cameras.py
@@ -0,0 +1,62 @@
+"""Relay a place's camera to signed-in dashboard users while they watch it."""
+
+from urllib.parse import urlsplit, urlunsplit
+
+import httpx
+from fastapi import APIRouter, Depends, HTTPException, Request
+from fastapi.responses import StreamingResponse
+
+from ..auth.dependencies import current_user
+from ..auth.store import User
+
+router = APIRouter(tags=["cameras"])
+
+
+def _stream_url(url: str) -> str:
+    # Lab cameras follow uStreamer's layout, exporting /snapshot beside /stream.
+    parts = urlsplit(url)
+    if parts.path.endswith("/snapshot"):
+        parts = parts._replace(path=parts.path.removesuffix("snapshot") + "stream")
+    return urlunsplit(parts)
+
+
+@router.get("/places/{name}/cameras/{resource}")
+async def camera_stream(
+    name: str,
+    resource: str,
+    request: Request,
+    user: User = Depends(current_user),
+):
+    camera = request.app.state.coordinator.get_resource(name, resource)
+    url = camera.params.get("url") if camera and camera.cls == "HTTPVideoStream" else None
+    if not isinstance(url, str) or urlsplit(url).scheme not in {"http", "https"}:
+        raise HTTPException(status_code=404, detail="place has no such HTTP camera")
+
+    # The URL is resolved from this host, as the exporter publishes it.
+    client = httpx.AsyncClient(timeout=httpx.Timeout(10, read=30), trust_env=False)
+    try:
+        upstream = await client.send(client.build_request("GET", _stream_url(url)), stream=True)
+    except httpx.HTTPError as e:
+        await client.aclose()
+        raise HTTPException(status_code=502, detail=f"camera unreachable: {e}")
+    if upstream.status_code != 200:
+        await upstream.aclose()
+        await client.aclose()
+        raise HTTPException(status_code=502, detail=f"camera returned {upstream.status_code}")
+
+    async def frames():
+        # Closing on disconnect stops the camera's encoder until the next viewer.
+        try:
+            async for chunk in upstream.aiter_raw():
+                yield chunk
+        except httpx.HTTPError:
+            pass
+        finally:
+            await upstream.aclose()
+            await client.aclose()
+
+    return StreamingResponse(
+        frames(),
+        media_type=upstream.headers.get("content-type", "multipart/x-mixed-replace"),
+        headers={"Cache-Control": "no-store", "X-Accel-Buffering": "no"},
+    )
