+import { useEffect, useRef, useState } from "react";
+import { Box, Button, HStack, Image, Text } from "@chakra-ui/react";
+
+interface Props {
+  place: string;
+  resource: string;
+}
+
+/** Live MJPEG view of a place's camera; connects only while shown. */
+export default function CameraView({ place, resource }: Props) {
+  const [shown, setShown] = useState(false);
+  const [failed, setFailed] = useState(false);
+  const image = useRef<HTMLImageElement>(null);
+  const src = `/api/places/${encodeURIComponent(place)}/cameras/${encodeURIComponent(resource)}`;
+
+  // Browsers may keep a detached MJPEG image downloading; drop it explicitly.
+  useEffect(() => {
+    const element = image.current;
+    return () => {
+      if (element) element.src = "";
+    };
+  }, [shown, failed]);
+
+  const toggle = () => {
+    setFailed(false);
+    setShown((s) => !s);
+  };
+
+  return (
+    <Box mb={4}>
+      <HStack mb={2}>
+        <Text fontSize="sm">{resource}</Text>
+        <Button ml="auto" size="xs" onClick={toggle}>
+          {shown ? "Hide live view" : "Show live view"}
+        </Button>
+      </HStack>
+      {shown && (failed ? (
+        <Text color="text.secondary" fontSize="sm">
+          Camera unavailable. Hide and show the live view to retry.
+        </Text>
+      ) : (
+        <Image
+          ref={image}
+          src={src}
+          alt={`Live view of ${place}`}
+          maxW="360px"
+          w="full"
+          borderRadius="md"
+          onError={() => setFailed(true)}
+        />
+      ))}
+    </Box>
+  );
+}
