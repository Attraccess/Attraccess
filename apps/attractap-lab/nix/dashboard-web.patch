diff --git a/coordinator/web/src/pages/__tests__/PlaceDetailCamera.test.tsx b/coordinator/web/src/pages/__tests__/PlaceDetailCamera.test.tsx
new file mode 100644
index 0000000..e7cfe0e
--- /dev/null
+++ b/coordinator/web/src/pages/__tests__/PlaceDetailCamera.test.tsx
@@ -0,0 +1,61 @@
+import { describe, it, expect, vi } from "vitest";
+import { render, screen, fireEvent } from "@testing-library/react";
+import { MemoryRouter, Routes, Route, Link } from "react-router-dom";
+import { ChakraProvider } from "@chakra-ui/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import PlaceDetail from "../PlaceDetail";
+
+// vi.mock is hoisted above imports; its fixtures must be too.
+const { place, camera } = vi.hoisted(() => {
+  const place = (name: string) => ({
+    name, aliases: [], comment: "", tags: {},
+    matches: [{ exporter: "lab", group: name, cls: "*" }],
+    acquired: null, acquired_resources: [], allowed: [], created: 0, changed: 0,
+    reservation: null, acquired_username: null,
+  });
+  const camera = (group: string) => ({
+    exporter: "lab", group, cls: "HTTPVideoStream", name: "HTTPVideoStream",
+    params: { url: `http://127.0.0.1:8082/${group}/snapshot` }, acquired: null, avail: true,
+  });
+  return { place, camera };
+});
+
+vi.mock("../../api/client", () => ({
+  api: {
+    getPlace: vi.fn((name: string) => Promise.resolve(place(name))),
+    getResources: vi.fn().mockResolvedValue([camera("reader-1"), camera("reader-2")]),
+  },
+}));
+vi.mock("../../auth/AuthContext", () => ({
+  useAuth: () => ({ user: { username: "alice", role: "user" }, loading: false }),
+}));
+
+describe("PlaceDetail camera", () => {
+  it("does not carry an open live view to another place", async () => {
+    const qc = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+    // A previously visited place renders at once, reusing the mounted page.
+    qc.setQueryData(["place", "reader-2"], place("reader-2"));
+    render(
+      <ChakraProvider>
+        <QueryClientProvider client={qc}>
+          <MemoryRouter initialEntries={["/places/reader-1"]}>
+            <Link to="/places/reader-2">next place</Link>
+            <Routes>
+              <Route path="/places/:name" element={<PlaceDetail />} />
+            </Routes>
+          </MemoryRouter>
+        </QueryClientProvider>
+      </ChakraProvider>
+    );
+
+    fireEvent.click(await screen.findByRole("button", { name: "Show live view" }));
+    expect(screen.getByRole("img").getAttribute("src")).toBe(
+      "/api/places/reader-1/cameras/HTTPVideoStream"
+    );
+
+    fireEvent.click(screen.getByText("next place"));
+    expect(await screen.findByRole("heading", { name: "reader-2" })).toBeTruthy();
+    expect(screen.getByRole("button", { name: "Show live view" })).toBeTruthy();
+    expect(screen.queryByRole("img")).toBeNull();
+  });
+});
