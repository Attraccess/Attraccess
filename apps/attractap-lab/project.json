{
  "name": "attractap-lab",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/attractap-lab/src",
  "projectType": "application",
  "tags": ["scope:hardware"],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nix flake check path:./apps/attractap-lab --all-systems --no-build --no-write-lock-file"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nix build path:./apps/attractap-lab#attractap-lab --no-link --no-write-lock-file"
      },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nix flake check path:./apps/attractap-lab --print-build-logs --no-write-lock-file"
      },
      "cache": false,
      "dependsOn": ["test-scripts"]
    },
    "test-scripts": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/attractap/firmware/tests/reference-recordings/recordings/**/*",
        {
          "runtime": "node -p \"process.platform + '-' + process.arch + '-' + process.version\""
        }
      ],
      "outputs": [],
      "options": {
        "command": "node --test apps/attractap-lab/real-cards/*.test.mjs apps/attractap-lab/real-cards/replay/*.test.mjs"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nix run path:./apps/attractap-lab --"
      },
      "cache": false
    },
    "hil": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./hil/run.sh",
        "cwd": "apps/attractap-lab"
      },
      "cache": false
    },
    "crap-score": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/crap-score/run.mjs apps/attractap-lab"
      }
    }
  }
}
