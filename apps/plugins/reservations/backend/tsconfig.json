{
  // Extends the workspace base so the `@attraccess/*` path aliases resolve (the host SDK only exists as one).
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.test-utils.ts"]
}
