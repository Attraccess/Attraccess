{
  "name": "@attraccess/plugin-reservations",
  "version": "0.1.0-alpha.0",
  "description": "Official Attraccess plugin to reserve resources for a specific time window.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Attraccess/Attraccess.git",
    "directory": "apps/plugins/reservations"
  },
  "homepage": "https://attraccess.org",
  "keywords": [
    "attraccess-plugin",
    "attraccess",
    "reservations",
    "booking"
  ],
  "files": [
    "dist",
    "frontend"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@attraccess/plugins-backend-sdk": "^2.0.0-0",
    "@attraccess/plugins-frontend-sdk": "^2.0.0-0",
    "@attraccess/plugins-frontend-ui": "^2.0.0-0"
  },
  "attraccess": {
    "displayName": "Reservations",
    "description": "Reserve a resource for a specific time window.",
    "host": "^2.0.0-0",
    "backend": "dist/index.js",
    "frontend": "frontend/remoteEntry.js",
    "persistence": {
      "backends": [
        "sqlite"
      ]
    },
    "migrations": "dist/migrations.js",
    "styles": "frontend/style.css",
    "dashboardPaths": [
      "/reservations",
      "/reservations/manage"
    ],
    "dashboardWidgets": [
      "reservations-upcoming"
    ],
    "permissions": [
      "DATABASE_ACCESS",
      "ACCESS_HOOKS",
      "LISTEN_EVENTS",
      "ACCESS_RESOURCES",
      "READ_USERS",
      "READ_SETTINGS",
      "SEND_NOTIFICATIONS"
    ],
    "license": {
      "required": true,
      "modules": [
        "reservations"
      ]
    },
    "sdk": {
      "backend": "^2.0.0-0",
      "frontend": "^2.0.0-0"
    }
  }
}
