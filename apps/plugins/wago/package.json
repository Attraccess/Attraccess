{
  "name": "@attraccess/plugin-wago",
  "version": "0.1.0-alpha.0",
  "description": "Attraccess integration for WAGO CC100 controllers. Operational control only: not a safety function, and not yet qualified for physical use.",
  "keywords": [
    "attraccess-plugin",
    "attraccess",
    "wago",
    "cc100"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Attraccess/Attraccess.git",
    "directory": "apps/plugins/wago"
  },
  "homepage": "https://attraccess.org",
  "files": [
    "dist",
    "frontend"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@attraccess/plugins-backend-sdk": "^2.0.0-0",
    "@attraccess/plugins-frontend-sdk": "^2.0.0-0",
    "@attraccess/plugins-frontend-ui": "^2.0.0-0"
  },
  "attraccess": {
    "displayName": "WAGO CC100",
    "description": "Discover, claim, and monitor WAGO CC100 controllers.",
    "host": "^2.0.0-0",
    "backend": "dist/index.js",
    "frontend": "frontend/remoteEntry.js",
    "styles": "frontend/style.css",
    "license": {
      "required": true,
      "modules": [
        "wago"
      ]
    },
    "dashboardPaths": [
      "/wago"
    ],
    "permissions": [
      "PLUGIN_STORAGE",
      "ACCESS_MQTT_SERVERS",
      "TRIGGER_FLOWS",
      "MANAGE_SECRETS"
    ],
    "sdk": {
      "backend": "^2.0.0-0",
      "frontend": "^2.0.0-0"
    }
  }
}
