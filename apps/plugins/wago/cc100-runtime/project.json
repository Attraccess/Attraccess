{
  "name": "wago-cc100-runtime",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/plugins/wago/cc100-runtime/src",
  "projectType": "application",
  "tags": ["scope:hardware", "type:plugin"],
  "targets": {
    "test-simulator-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node apps/plugins/wago/cc100-runtime/integration/run.mjs" }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "dependsOn": [],
      "outputs": ["{workspaceRoot}/dist/apps/wago-cc100-runtime"],
      "options": {
        "main": "apps/plugins/wago/cc100-runtime/src/main.ts",
        "tsConfig": "apps/plugins/wago/cc100-runtime/tsconfig.json",
        "outputPath": "dist/apps/wago-cc100-runtime",
        "platform": "node",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "generatePackageJson": true,
        "esbuildOptions": { "target": "node24" }
      }
    },
    "stage-plugin-release": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "{workspaceRoot}/runtime-release/**/*",
        "{workspaceRoot}/apps/plugins/wago/scripts/stage-runtime-release-for-plugin.mjs"
      ],
      "outputs": ["{workspaceRoot}/apps/plugins/wago/runtime-release"],
      "options": {
        "command": "node apps/plugins/wago/scripts/stage-runtime-release-for-plugin.mjs"
      }
    },
    "build-simulator": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{workspaceRoot}/dist/apps/wago-cc100-simulator"],
      "options": {
        "main": "apps/plugins/wago/cc100-runtime/src/simulator.ts",
        "tsConfig": "apps/plugins/wago/cc100-runtime/tsconfig.json",
        "outputPath": "dist/apps/wago-cc100-simulator",
        "platform": "node",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "generatePackageJson": true,
        "esbuildOptions": { "target": "node24" }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": { "jestConfig": "apps/plugins/wago/cc100-runtime/jest.config.ts" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/plugins/wago/cc100-runtime",
        "command": "eslint src --max-warnings=0 && prettier --check src"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/plugins/wago/cc100-runtime", "command": "tsc --noEmit -p tsconfig.json" }
    }
  }
}
