ARG NODE_VERSION=24.22.1
FROM node:${NODE_VERSION}-bookworm-slim AS build
WORKDIR /workspace
COPY . .
RUN corepack enable && pnpm install --frozen-lockfile && pnpm nx run plugin-wago:build-cc100-simulator

FROM node:${NODE_VERSION}-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
RUN useradd --system --uid 10001 runtime && mkdir -p /var/lib/attraccess-wago
COPY --from=build /workspace/dist/apps/wago-cc100-simulator ./
RUN chown -R runtime:runtime /app /var/lib/attraccess-wago
USER runtime
VOLUME ["/var/lib/attraccess-wago"]
CMD ["node", "simulator.cjs"]
