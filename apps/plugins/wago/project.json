{
  "name": "plugin-wago",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/plugins/wago",
  "tags": ["type:plugin", "scope:plugin"],
  "// lint": "lint runs from the workspace root on purpose: @nx/enforce-module-boundaries no-ops when eslint runs from inside a project directory. See eslint.config.cjs for the plugin isolation rules.",
  "targets": {
    "build-cc100-runtime": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build-cc100-runtime-esbuild"],
      "inputs": ["default", "{projectRoot}/cc100-runtime/package.json", "{projectRoot}/cc100-runtime/pnpm-lock.yaml"],
      "outputs": ["{workspaceRoot}/dist/apps/wago-cc100-runtime"],
      "options": {
        "command": "node apps/plugins/wago/cc100-runtime/write-package.mjs dist/apps/wago-cc100-runtime ./main.cjs && cp apps/plugins/wago/cc100-runtime/pnpm-lock.yaml dist/apps/wago-cc100-runtime/"
      }
    },
    "build-cc100-runtime-esbuild": {
      "inputs": ["default", "{projectRoot}/cc100-runtime/src/**/*", "{projectRoot}/channel-behavior.ts", "{projectRoot}/backend/protocol.ts", "{projectRoot}/backend/protocol/**/*", "{projectRoot}/backend/**/*.entity.ts", "{projectRoot}/modbus/**/*"],
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{workspaceRoot}/dist/apps/wago-cc100-runtime"],
      "options": {
        "main": "apps/plugins/wago/cc100-runtime/src/main.ts",
        "tsConfig": "apps/plugins/wago/cc100-runtime/tsconfig.json",
        "outputPath": "dist/apps/wago-cc100-runtime",
        "platform": "node",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "generatePackageJson": false,
        "esbuildOptions": { "target": "node24" }
      }
    },
    "build-cc100-simulator": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build-cc100-simulator-esbuild"],
      "inputs": ["default", "{projectRoot}/cc100-runtime/package.json", "{projectRoot}/cc100-runtime/pnpm-lock.yaml"],
      "outputs": ["{workspaceRoot}/dist/apps/wago-cc100-simulator"],
      "options": {
        "command": "node apps/plugins/wago/cc100-runtime/write-package.mjs dist/apps/wago-cc100-simulator ./simulator.cjs && cp apps/plugins/wago/cc100-runtime/pnpm-lock.yaml dist/apps/wago-cc100-simulator/"
      }
    },
    "build-cc100-simulator-esbuild": {
      "inputs": ["default", "{projectRoot}/cc100-runtime/src/**/*", "{projectRoot}/channel-behavior.ts", "{projectRoot}/modbus/**/*"],
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{workspaceRoot}/dist/apps/wago-cc100-simulator"],
      "options": {
        "main": "apps/plugins/wago/cc100-runtime/src/simulator.ts",
        "tsConfig": "apps/plugins/wago/cc100-runtime/tsconfig.json",
        "outputPath": "dist/apps/wago-cc100-simulator",
        "platform": "node",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "generatePackageJson": false,
        "esbuildOptions": { "target": "node24" }
      }
    },
    "test-cc100-runtime": {
      "inputs": ["default", "{projectRoot}/cc100-runtime/src/**/*", "{projectRoot}/channel-behavior.ts", "{projectRoot}/modbus/**/*", "{projectRoot}/measurement-contract.ts", "{projectRoot}/backend/protocol.ts", "{projectRoot}/backend/protocol/**/*", "{projectRoot}/backend/**/*.entity.ts"],
      "executor": "@nx/jest:jest",
      "options": { "jestConfig": "apps/plugins/wago/cc100-runtime/jest.config.ts" }
    },
    "lint-cc100-runtime": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/plugins/wago/cc100-runtime/src --max-warnings=0 && prettier --check apps/plugins/wago/cc100-runtime/src"
      }
    },
    "typecheck-cc100-runtime": {
      "inputs": ["default", "{projectRoot}/cc100-runtime/src/**/*", "{projectRoot}/channel-behavior.ts", "{projectRoot}/modbus/**/*", "{projectRoot}/measurement-contract.ts", "{projectRoot}/backend/protocol.ts", "{projectRoot}/backend/protocol/**/*", "{projectRoot}/backend/**/*.entity.ts"],
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/plugins/wago/cc100-runtime", "command": "tsc --noEmit -p tsconfig.json" }
    },
    "test-cc100-simulator-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node apps/plugins/wago/cc100-runtime/integration/run.mjs" }
    },
    "crap-score-cc100-runtime": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/crap-score/run.mjs apps/plugins/wago/cc100-runtime"
      }
    },
    "production-fleet": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["typecheck-acceptance", "test-production-fleet-cleanup"],
      "options": {
        "command": "node apps/plugins/wago/scripts/test-production-fleet.mjs"
      }
    },
    "typecheck-acceptance": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p apps/plugins/wago/acceptance/tsconfig.json"
      }
    },
    "test-production-fleet-cleanup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test apps/plugins/wago/scripts/test-production-fleet.test.mjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec tsc --noEmit -p apps/plugins/wago/tsconfig.spec.json",
          "pnpm exec tsc --noEmit -p apps/plugins/wago/acceptance/tsconfig.json"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/plugins/wago/backend apps/plugins/wago/frontend/src apps/plugins/wago/frontend/tests apps/plugins/wago/acceptance apps/plugins/wago/modbus apps/plugins/wago/shared apps/plugins/wago/cc100-runtime apps/plugins/wago/diagnostics-types.ts apps/plugins/wago/measurement-contract.ts apps/plugins/wago/channel-behavior.ts"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "dependsOn": ["test-frontend"],
      "options": {
        "jestConfig": "apps/plugins/wago/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "test-frontend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/frontend/**/*", "{projectRoot}/modbus/**/*", "{projectRoot}/channel-behavior.ts"],
      "options": {
        "command": "pnpm exec vitest run --config apps/plugins/wago/frontend/vitest.config.mts"
      }
    },
    "build-backend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/diagnostics-types.ts",
        "{projectRoot}/channel-behavior.ts",
        "{projectRoot}/backend/**/*",
        "{projectRoot}/modbus/**/*",
        "{projectRoot}/measurement-contract.ts",
        "{projectRoot}/cc100-runtime/signing-public-key.pub",
        "{workspaceRoot}/apps/plugins/scripts/esbuild-backend.mjs"
      ],
      "outputs": ["{projectRoot}/package/dist"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "node ../scripts/esbuild-backend.mjs --entry backend/plugin.ts --outfile package/dist/index.js --entry backend/migrations.ts --outfile package/dist/migrations.js && cp cc100-runtime/signing-public-key.pub package/dist/signing-public-key.pub"
      }
    },
    "build-frontend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/diagnostics-types.ts",
        "{projectRoot}/channel-behavior.ts",
        "{projectRoot}/frontend/**/*",
        "{projectRoot}/modbus/**/*",
        "{workspaceRoot}/apps/plugins/scripts/vite-federation.config.mjs"
      ],
      "outputs": ["{projectRoot}/package/frontend"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "pnpm exec vite build --config frontend/vite.config.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build-backend", "build-frontend"],
      "inputs": ["{projectRoot}/package.json", "{projectRoot}/plugin.json"],
      "outputs": ["{projectRoot}/package/package.json", "{projectRoot}/package/plugin.json"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "node -e \"for (const file of ['package.json', 'plugin.json']) require('fs').copyFileSync(file, 'package/' + file)\""
      }
    },
    "zip": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["{projectRoot}/package/**/*", "{workspaceRoot}/apps/plugins/scripts/zip-plugin.mjs"],
      "outputs": ["{projectRoot}/dist/plugin-wago.zip"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "node ../scripts/zip-plugin.mjs --src package --out dist/plugin-wago.zip"
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["{projectRoot}/package/**/*"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "rm -rf dist && mkdir dist && (cd package && npm pack --pack-destination ../dist)"
      }
    },
    "pack-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["pack", "plugins-backend-sdk:build"],
      "inputs": [
        "{projectRoot}/package/**/*",
        "{workspaceRoot}/apps/plugins/scripts/verify-packed-plugin.mjs",
        "{workspaceRoot}/package.json"
      ],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "node ../scripts/verify-packed-plugin.mjs package package.json dist/index.js dist/migrations.js frontend/remoteEntry.js frontend/style.css"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["pack-test"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "node ../scripts/publish-plugin.mjs package dist"
      }
    },
    "fleet-acceptance": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "pnpm nx run-many -p plugin-wago -t test,typecheck,lint,build --parallel=2",
          "pnpm nx run plugin-wago:test-cc100-runtime",
          "pnpm nx run plugin-wago:typecheck-cc100-runtime",
          "pnpm nx run plugin-wago:lint-cc100-runtime",
          "pnpm nx run plugin-wago:build-cc100-runtime",
          "pnpm nx run plugin-wago:test-cc100-simulator-integration",
          "pnpm nx run plugin-wago:production-fleet",
          "pnpm nx run plugin-wago:test-commissioning-acceptance",
          "pnpm nx run plugin-wago:e2e",
          "bash apps/plugins/wago/frontend/tests/run_browser_tests.sh",
          "node --test apps/plugins/wago/scripts/check-acceptance.test.mjs"
        ],
        "parallel": false
      }
    },
    "typecheck-frontend-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p apps/plugins/wago/frontend/tsconfig.tests.json"
      }
    },
    "test-typecheck-frontend-gate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node --test apps/plugins/wago/scripts/typecheck-frontend-tests.test.mjs",
          "node apps/plugins/wago/scripts/typecheck-frontend-tests.mjs"
        ],
        "parallel": false
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["typecheck-acceptance"],
      "options": {
        "command": "pnpm exec jest --config apps/plugins/wago/scripts/jest.audit-hooks.config.cjs --runInBand"
      }
    },
    "test-commissioning-acceptance": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["typecheck-acceptance", "typecheck-frontend-tests"],
      "options": {
        "commands": [
          "pnpm exec jest --config apps/plugins/wago/scripts/jest.commissioning.config.cjs --runInBand",
          "pnpm exec vite build --config apps/plugins/wago/frontend/tests/commissioning-harness/vite.config.mts",
          "pnpm exec jest --config apps/plugins/wago/scripts/jest.commissioning-browser.config.cjs --runInBand"
        ],
        "parallel": false
      }
    },
    "crap-score": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/crap-score/run.mjs apps/plugins/wago"
      }
    }
  }
}
