{
  "name": "plugin-wago",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/plugins/wago",
  "tags": ["type:plugin"],
  "targets": {
    "production-fleet": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["typecheck-acceptance", "test-production-fleet-cleanup"],
      "options": {
        "command": "node scripts/test-wago-production-fleet.mjs"
      }
    },
    "typecheck-acceptance": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p apps/plugins/wago/acceptance/tsconfig.json"
      }
    },
    "test-production-fleet-cleanup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test scripts/test-wago-production-fleet.test.mjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec tsc --noEmit -p apps/plugins/wago/tsconfig.spec.json",
          "pnpm exec tsc --noEmit -p apps/plugins/wago/frontend/tsconfig.app.json",
          "pnpm exec tsc --noEmit -p apps/plugins/wago/frontend/tsconfig.tests.json",
          "pnpm exec tsc --noEmit -p apps/plugins/wago/acceptance/tsconfig.json"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "eslint backend frontend/src frontend/tests acceptance modbus measurement-contract.ts"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "dependsOn": ["test-frontend"],
      "options": {
        "jestConfig": "apps/plugins/wago/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "test-frontend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/frontend/**/*", "{projectRoot}/modbus/**/*"],
      "options": {
        "command": "pnpm exec vitest run --config apps/plugins/wago/frontend/vitest.config.mts"
      }
    },
    "build-backend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/diagnostics-types.ts",
        "{projectRoot}/backend/**/*",
        "{projectRoot}/modbus/**/*",
        "{projectRoot}/measurement-contract.ts",
        "{projectRoot}/cc100-runtime/signing-public-key.pub",
        "{workspaceRoot}/apps/plugins/scripts/esbuild-backend.mjs"
      ],
      "outputs": ["{projectRoot}/package/dist"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "node ../scripts/esbuild-backend.mjs --entry backend/plugin.ts --outfile package/dist/index.js --entry backend/migrations.ts --outfile package/dist/migrations.js && cp cc100-runtime/signing-public-key.pub package/dist/signing-public-key.pub"
      }
    },
    "build-frontend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/diagnostics-types.ts",
        "{projectRoot}/frontend/**/*",
        "{projectRoot}/modbus/**/*",
        "{workspaceRoot}/apps/plugins/scripts/vite-federation.config.mjs"
      ],
      "outputs": ["{projectRoot}/package/frontend"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "pnpm exec vite build --config frontend/vite.config.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build-backend", "build-frontend"],
      "inputs": ["{projectRoot}/package.json", "{projectRoot}/plugin.json"],
      "outputs": ["{projectRoot}/package/package.json", "{projectRoot}/package/plugin.json"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "node -e \"for (const file of ['package.json', 'plugin.json']) require('fs').copyFileSync(file, 'package/' + file)\""
      }
    },
    "zip": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["{projectRoot}/package/**/*", "{workspaceRoot}/apps/plugins/scripts/zip-plugin.mjs"],
      "outputs": ["{projectRoot}/dist/plugin-wago.zip"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "node ../scripts/zip-plugin.mjs --src package --out dist/plugin-wago.zip"
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["{projectRoot}/package/**/*"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "rm -rf dist && mkdir dist && (cd package && npm pack --pack-destination ../dist)"
      }
    },
    "pack-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["pack", "plugins-backend-sdk:build"],
      "inputs": [
        "{projectRoot}/package/**/*",
        "{workspaceRoot}/apps/plugins/scripts/verify-packed-plugin.mjs",
        "{workspaceRoot}/package.json"
      ],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "node ../scripts/verify-packed-plugin.mjs package package.json dist/index.js dist/migrations.js frontend/remoteEntry.js frontend/style.css"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["pack-test"],
      "options": {
        "cwd": "apps/plugins/wago",
        "command": "node ../scripts/publish-plugin.mjs package dist"
      }
    },
    "fleet-acceptance": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "pnpm nx run-many -p plugin-wago,wago-cc100-runtime -t test,typecheck,lint,build --parallel=2",
          "node apps/plugins/wago/cc100-runtime/integration/run.mjs",
          "pnpm nx run plugin-wago:production-fleet",
          "pnpm nx run plugin-wago:test-commissioning-acceptance",
          "bash apps/plugins/wago/frontend/tests/run_browser_tests.sh",
          "node --test scripts/check-wago-acceptance.test.mjs"
        ],
        "parallel": false
      }
    },
    "typecheck-frontend-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p apps/plugins/wago/frontend/tsconfig.tests.json"
      }
    },
    "test-typecheck-frontend-gate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node --test scripts/typecheck-wago-frontend-tests.test.mjs",
          "node scripts/typecheck-wago-frontend-tests.mjs"
        ],
        "parallel": false
      }
    },
    "test-commissioning-acceptance": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["typecheck-acceptance", "typecheck-frontend-tests"],
      "options": {
        "commands": [
          "pnpm exec jest --config scripts/test-wago-commissioning.config.cjs --runInBand",
          "pnpm exec vite build --config apps/plugins/wago/frontend/tests/commissioning-harness/vite.config.mts",
          "pnpm exec jest --config scripts/test-wago-commissioning-browser.config.cjs --runInBand"
        ],
        "parallel": false
      }
    }
  }
}
