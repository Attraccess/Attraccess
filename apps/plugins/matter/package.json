{
  "name": "@attraccess/plugin-matter",
  "version": "0.4.0-alpha.0",
  "description": "Official Attraccess integration for Matter devices. Connects to the Matter sidecar; no device features yet.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Attraccess/Attraccess.git",
    "directory": "apps/plugins/matter"
  },
  "homepage": "https://attraccess.org",
  "keywords": [
    "attraccess-plugin",
    "attraccess",
    "matter"
  ],
  "files": [
    "dist",
    "frontend"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@attraccess/plugins-backend-sdk": "^1.9.0",
    "@attraccess/plugins-frontend-sdk": "^1.9.0",
    "@attraccess/plugins-frontend-ui": "^1.11.0"
  },
  "attraccess": {
    "displayName": "Matter",
    "description": "Matter device support for Attraccess. Secure connection to the Matter sidecar; device features follow.",
    "host": "^1.11.0",
    "backend": "dist/index.js",
    "frontend": "frontend/remoteEntry.js",
    "migrations": "dist/migrations.js",
    "styles": "frontend/style.css",
    "permissions": [
      "DATABASE_ACCESS",
      "MANAGE_SECRETS"
    ],
    "sdk": {
      "backend": "^1.9.0",
      "frontend": "^1.9.0"
    }
  }
}
