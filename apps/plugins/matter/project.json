{
  "name": "plugin-matter",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/plugins/matter",
  "tags": ["type:plugin", "scope:plugin"],
  "// lint": "lint runs from the workspace root on purpose: @nx/enforce-module-boundaries no-ops when eslint runs from inside a project directory. See eslint.config.cjs for the plugin isolation rules.",
  "targets": {
    "install-dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/plugins/scripts/install-dev-plugin.mjs --src apps/plugins/matter/package"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/backend/**/*",
        "{projectRoot}/frontend/src/**/*",
        "{projectRoot}/acceptance/**/*",
        "{workspaceRoot}/eslint.config.cjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        "{workspaceRoot}/libs/matter-contract/project.json",
        {
          "externalDependencies": ["eslint", "prettier"]
        }
      ],
      "outputs": [],
      "options": {
        "command": "eslint apps/plugins/matter/backend apps/plugins/matter/frontend/src apps/plugins/matter/acceptance --max-warnings=0 && prettier --check apps/plugins/matter/backend apps/plugins/matter/frontend/src apps/plugins/matter/acceptance apps/plugins/matter/package.json apps/plugins/matter/plugin.json apps/plugins/matter/project.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/libs/plugins-backend-sdk/src/**/*",
        "{workspaceRoot}/libs/matter-contract/src/**/*",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc --noEmit -p apps/plugins/matter/backend/tsconfig.json && tsc --noEmit -p apps/plugins/matter/frontend/tsconfig.json && tsc --noEmit -p apps/plugins/matter/tsconfig.spec.json"
      }
    },
    "test-frontend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/frontend/**/*",
        "{workspaceRoot}/libs/plugins-frontend-sdk/src/**/*",
        "{workspaceRoot}/libs/plugins-frontend-ui/src/**/*"
      ],
      "outputs": ["{workspaceRoot}/coverage/apps/plugins/matter/test-frontend"],
      "options": {
        "cwd": "apps/plugins/matter",
        "command": "pnpm exec vitest run --root frontend"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/libs/matter-contract/src/**/*",
        {
          "externalDependencies": ["jest"]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/apps/plugins/matter/test"],
      "options": {
        "jestConfig": "apps/plugins/matter/jest.config.ts"
      },
      "dependsOn": ["test-frontend"]
    },
    "e2e": {
      "executor": "@nx/jest:jest",
      "cache": true,
      "dependsOn": ["build-backend", "matter-sidecar:build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/apps/api/src/plugin-system/**/*",
        "{workspaceRoot}/libs/matter-contract/src/**/*",
        {
          "externalDependencies": ["jest"]
        },
        "{workspaceRoot}/apps/matter-sidecar/src/**/*"
      ],
      "outputs": [],
      "options": {
        "jestConfig": "apps/plugins/matter/jest.e2e.config.ts"
      }
    },
    "build-backend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/backend/**/!(*.spec).ts",
        "{workspaceRoot}/apps/plugins/scripts/esbuild-backend.mjs",
        "{workspaceRoot}/libs/matter-contract/src/**/!(*.spec).ts",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{projectRoot}/package/dist"],
      "options": {
        "cwd": "apps/plugins/matter",
        "command": "node ../scripts/esbuild-backend.mjs --tsconfig backend/tsconfig.json --entry backend/plugin.ts --outfile package/dist/index.js --entry backend/migrations.ts --outfile package/dist/migrations.js"
      }
    },
    "build-frontend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/frontend/**/*",
        "{workspaceRoot}/libs/plugins-frontend-sdk/src/**/*",
        "{workspaceRoot}/apps/plugins/scripts/vite-federation.config.mjs",
        "{workspaceRoot}/apps/plugins/scripts/host-shared-placeholder.mjs"
      ],
      "outputs": ["{projectRoot}/package/frontend"],
      "options": {
        "cwd": "apps/plugins/matter",
        "command": "pnpm exec vite build --config frontend/vite.config.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build-backend", "build-frontend"],
      "inputs": ["{projectRoot}/package.json", "{projectRoot}/plugin.json"],
      "outputs": ["{projectRoot}/package/package.json", "{projectRoot}/package/plugin.json"],
      "options": {
        "cwd": "apps/plugins/matter",
        "command": "node -e \"for (const file of ['package.json', 'plugin.json']) require('fs').copyFileSync(file, 'package/' + file)\""
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["{projectRoot}/package/**/*"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/plugins/matter",
        "command": "rm -rf dist && mkdir dist && (cd package && npm pack --pack-destination ../dist)"
      }
    },
    "pack-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["pack", "plugins-backend-sdk:build"],
      "inputs": [
        "{projectRoot}/package/**/*",
        "{workspaceRoot}/apps/plugins/scripts/verify-packed-plugin.mjs",
        "{workspaceRoot}/package.json"
      ],
      "options": {
        "cwd": "apps/plugins/matter",
        "command": "node ../scripts/verify-packed-plugin.mjs package package.json dist/index.js dist/migrations.js frontend/remoteEntry.js frontend/style.css",
        "env": {
          "ATTRACCESS_PLUGIN_TEST_HOST_VERSION": "1.11.0"
        }
      }
    },
    "crap-score": {
      "dependsOn": ["test", "test-frontend"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/crap-score/run.mjs apps/plugins/matter"
      }
    }
  }
}
