{
  "name": "rabbitmq",
  "version": "0.1.0",
  "main": {
    "backend": {
      "directory": "dist",
      "entryPoint": "index.js"
    },
    "frontend": {
      "directory": "frontend",
      "entryPoint": "remoteEntry.js",
      "styles": "style.css"
    }
  },
  "attraccessVersion": {
    "min": "2.0.0-0"
  },
  "persistence": { "backends": ["sqlite"] },
  "permissions": ["ACCESS_MQTT_SERVERS"]
}
