{
  "name": "plugin-shelly",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/plugins/shelly",
  "tags": ["type:plugin"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/backend/**/*", "{projectRoot}/frontend/src/**/*", "{workspaceRoot}/eslint.config.cjs"],
      "outputs": [],
      "options": {
        "cwd": "apps/plugins/shelly",
        "command": "eslint backend frontend/src"
      }
    },
    "test-frontend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/frontend/**/*"],
      "outputs": [],
      "options": {
        "cwd": "apps/plugins/shelly",
        "command": "pnpm exec vitest run --root frontend"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "cache": true,
      "dependsOn": ["test-frontend"],
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js", { "externalDependencies": ["jest"] }],
      "outputs": ["{workspaceRoot}/coverage/apps/plugins/shelly"],
      "options": {
        "jestConfig": "apps/plugins/shelly/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "build-backend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/backend/**/*", "{workspaceRoot}/apps/plugins/scripts/esbuild-backend.mjs"],
      "outputs": ["{projectRoot}/package/dist"],
      "options": {
        "cwd": "apps/plugins/shelly",
        "command": "node ../scripts/esbuild-backend.mjs --entry backend/plugin.ts --outfile package/dist/index.js --entry backend/migrations.ts --outfile package/dist/migrations.js"
      }
    },
    "build-frontend": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/frontend/**/*", "{workspaceRoot}/apps/plugins/scripts/vite-federation.config.mjs"],
      "outputs": ["{projectRoot}/package/frontend"],
      "options": {
        "cwd": "apps/plugins/shelly",
        "command": "pnpm exec vite build --config frontend/vite.config.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build-backend", "build-frontend"],
      "inputs": ["{projectRoot}/package.json", "{projectRoot}/plugin.json"],
      "outputs": ["{projectRoot}/package"],
      "options": {
        "cwd": "apps/plugins/shelly",
        "command": "node -e \"for (const file of ['package.json', 'plugin.json']) require('fs').copyFileSync(file, 'package/' + file)\""
      }
    },
    "zip": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["{projectRoot}/package/**/*", "{workspaceRoot}/apps/plugins/scripts/zip-plugin.mjs"],
      "outputs": ["{projectRoot}/dist/plugin-shelly.zip"],
      "options": {
        "cwd": "apps/plugins/shelly",
        "command": "node ../scripts/zip-plugin.mjs --src package --out dist/plugin-shelly.zip"
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["{projectRoot}/package/**/*"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/plugins/shelly",
        "command": "rm -rf dist && mkdir dist && (cd package && npm pack --pack-destination ../dist)"
      }
    },
    "pack-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["pack", "plugins-backend-sdk:build"],
      "inputs": [
        "{projectRoot}/package/**/*",
        "{workspaceRoot}/apps/plugins/scripts/verify-packed-plugin.mjs",
        "{workspaceRoot}/package.json"
      ],
      "options": {
        "cwd": "apps/plugins/shelly",
        "command": "node ../scripts/verify-packed-plugin.mjs package package.json dist/index.js dist/migrations.js frontend/remoteEntry.js frontend/style.css"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["pack-test"],
      "options": {
        "cwd": "apps/plugins/shelly",
        "command": "node ../scripts/publish-plugin.mjs package dist"
      }
    }
  }
}
