{
  "name": "shelly",
  "version": "0.1.0",
  "main": {
    "backend": {
      "directory": "dist",
      "entryPoint": "index.js"
    },
    "migrations": {
      "directory": "dist",
      "entryPoint": "migrations.js"
    },
    "frontend": {
      "directory": "frontend",
      "entryPoint": "remoteEntry.js",
      "styles": "style.css",
      "dashboardPaths": ["/shelly"]
    }
  },
  "attraccessVersion": {
    "min": "2.0.0-0"
  },
  "persistence": { "backends": ["sqlite"] },
  "permissions": ["DATABASE_ACCESS"]
}
