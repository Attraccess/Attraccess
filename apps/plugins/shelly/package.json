{
  "name": "@attraccess/plugin-shelly",
  "version": "0.1.0-alpha.0",
  "description": "Official Attraccess integration for Shelly devices.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Attraccess/Attraccess.git",
    "directory": "apps/plugins/shelly"
  },
  "homepage": "https://attraccess.org",
  "keywords": [
    "attraccess-plugin",
    "attraccess",
    "shelly"
  ],
  "files": [
    "dist",
    "frontend"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@attraccess/plugins-backend-sdk": "^2.0.0-0",
    "@attraccess/plugins-frontend-sdk": "^2.0.0-0",
    "@attraccess/plugins-frontend-ui": "^2.0.0-0"
  },
  "attraccess": {
    "displayName": "Shelly",
    "description": "Control and monitor Shelly devices from Attraccess.",
    "host": "^2.0.0-0",
    "backend": "dist/index.js",
    "frontend": "frontend/remoteEntry.js",
    "styles": "frontend/style.css",
    "dashboardPaths": [
      "/shelly"
    ],
    "permissions": [
      "PLUGIN_STORAGE"
    ],
    "sdk": {
      "backend": "^2.0.0-0",
      "frontend": "^2.0.0-0"
    }
  }
}
