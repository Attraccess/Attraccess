{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["type:app", "scope:core"],
  "implicitDependencies": ["plugins-backend-sdk", "plugins-frontend-sdk"],
  "targets": {
    "copy-attractap-firmware-into-assets": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "cache": false,
      "options": {
        "command": "node {projectRoot}/copy-attractap-firmware-into-assets.js"
      }
    },
    "copy-companion-into-assets": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node {projectRoot}/copy-companion-into-assets.js"
      }
    },
    "prepare-kiosk-assets": {
      "executor": "nx:run-commands",
      "dependsOn": ["companion:build"],
      "cache": false,
      "options": {
        "command": "node {projectRoot}/copy-companion-into-assets.js && node scripts/validate-api-assets.mjs --companion=local"
      }
    },
    "prepare-attractap-assets": {
      "executor": "nx:run-commands",
      "dependsOn": ["attractap-firmware:build"],
      "cache": false,
      "options": {
        "command": "node {projectRoot}/copy-attractap-firmware-into-assets.js && node scripts/validate-api-assets.mjs --attractap"
      }
    },
    "prepare-all-assets": {
      "executor": "nx:run-commands",
      "dependsOn": ["companion:build", "attractap-firmware:build"],
      "cache": false,
      "options": {
        "command": "node {projectRoot}/copy-companion-into-assets.js && node {projectRoot}/copy-attractap-firmware-into-assets.js && node scripts/validate-api-assets.mjs --companion=local --attractap"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "production",
        "^production",
        {
          "runtime": "node scripts/validate-api-assets.mjs --hash"
        },
        {
          "externalDependencies": ["webpack-cli"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "cwd": "apps/api",
        "command": "webpack-cli build",
        "args": ["node-env=production"],
        "tsPlugins": ["@nestjs/swagger/plugin"]
      },
      "configurations": {
        "development": {
          "args": ["node-env=development"]
        }
      }
    },
    "swagger-build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["swagger", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/{projectName}-swagger"],
      "options": {
        "command": "webpack-cli build",
        "config": "apps/api/webpack.config.swagger.js",
        "args": ["node-env=production"],
        "output-path": "dist/apps/api-swagger"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "continuous": true,
      "dependsOn": [],
      "options": {
        "buildTarget": "api:build",
        "watch": true
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "export-swagger": {
      "executor": "nx:run-commands",
      "dependsOn": ["swagger-build"],
      "cache": true,
      "inputs": ["swagger", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/{projectName}-swagger/swagger.json"],
      "options": {
        "command": "LICENSE_KEY=\"I AM USING THIS SOFTWARE ONLY FOR NON-PROFIT AND COMPLY TO ALL TERMS OF THE LICENSE.md at https://github.com/Attraccess/Attraccess/blob/main/LICENSE.md\" AUTH_SESSION_SECRET=super-secret ATTRACCESS_URL=http://localhost:3000 SMTP_SERVICE=SMTP SMTP_HOST=not-a-host SMTP_PORT=1234 SMTP_FROM=mail@attraccess.org SKIP_DATABASE_MIGRATIONS=true node dist/apps/api-swagger/main.js"
      }
    },
    "asyncapi-build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/companion/companion.gateway.ts",
        "{projectRoot}/src/companion/companion.types.ts",
        "{projectRoot}/src/main.export-asyncapi.ts",
        "{projectRoot}/webpack.config.asyncapi.js"
      ],
      "outputs": ["{workspaceRoot}/dist/apps/api-asyncapi"],
      "options": {
        "command": "webpack-cli build",
        "config": "apps/api/webpack.config.asyncapi.js",
        "args": ["node-env=production"],
        "output-path": "dist/apps/api-asyncapi"
      }
    },
    "export-asyncapi": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "asyncapi-build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api/asyncapi.json"],
      "options": {
        "command": "node dist/apps/api-asyncapi/main.js"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/monitoring/grafana/provisioning/**/*",
        "{workspaceRoot}/monitoring/grafana/dashboards/**/*",
        "{workspaceRoot}/monitoring/prometheus/prometheus.yml",
        "{workspaceRoot}/apps/attractap/firmware/src/**/*",
        "{workspaceRoot}/apps/attractap/firmware/tests/reference-recordings/recordings/**/*",
        {
          "externalDependencies": ["jest"]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/apps/api"],
      "options": {
        "jestConfig": "apps/api/jest.config.ts",
        "testMatch": [
          "**/*.spec.ts",
          "!**/*.e2e.spec.ts",
          "!**/*.real-api.spec.ts",
          "!**/*.alerting.spec.ts",
          "!**/*.browser.spec.ts"
        ],
        "passWithNoTests": true
      },
      "dependsOn": ["test-scripts"]
    },
    "test-alerting": {
      "executor": "@nx/jest:jest",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/scripts/jest-docker-context.ts",
        "{workspaceRoot}/monitoring/grafana/provisioning/**/*",
        "{workspaceRoot}/monitoring/grafana/dashboards/**/*",
        "{workspaceRoot}/monitoring/prometheus/prometheus.yml",
        "{workspaceRoot}/coolify.docker-compose.yml",
        { "env": "ALERTING_GRAFANA_VERSION" },
        { "env": "ALERTING_REAL_TIME" },
        {
          "externalDependencies": ["jest", "testcontainers"]
        }
      ],
      "options": {
        "jestConfig": "apps/api/jest.alerting.config.ts",
        "passWithNoTests": false
      }
    },
    "e2e": {
      "executor": "@nx/jest:jest",
      "cache": true,
      "inputs": ["testing", "^production"],
      "outputs": ["{workspaceRoot}/coverage/apps/api-e2e"],
      "options": {
        "jestConfig": "apps/api/jest.e2e.config.ts",
        "testMatch": ["**/*.e2e.spec.ts"],
        "passWithNoTests": true
      }
    },
    "browser-e2e": {
      "executor": "@nx/jest:jest",
      "cache": false,
      "outputs": [],
      "options": {
        "jestConfig": "apps/api/jest.browser.config.ts",
        "passWithNoTests": false,
        "runInBand": true
      }
    },
    "start-services": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f docker-compose.dev.yml up -d --remove-orphans"
      },
      "cache": false
    },
    "build-migration-datasource": {
      "executor": "@nx/webpack:webpack",
      "cache": true,
      "inputs": ["typeorm", "{projectRoot}/src/config/storage-path.ts"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/migrations",
        "main": "apps/api/src/database/datasource.ts",
        "tsConfig": "apps/api/tsconfig.app.json",
        "webpackConfig": "apps/api/webpack.config.migrations.js"
      }
    },
    "migration-generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build-migration-datasource"],
      "options": {
        "cwd": ".",
        "commands": [
          "node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/apps/migrations/main.js migration:generate ./apps/api/src/database/migrations/{args.name}"
        ]
      }
    },
    "migrations-run": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build-migration-datasource"],
      "options": {
        "cwd": ".",
        "commands": [
          "node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/apps/migrations/main.js migration:run"
        ]
      }
    },
    "migration-revert": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build-migration-datasource"],
      "options": {
        "cwd": ".",
        "commands": [
          "node --env-file-if-exists=.env node_modules/typeorm/cli.js -d dist/apps/migrations/main.js migration:revert"
        ]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.cjs",
        "{projectRoot}/eslint.config.cjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "outputs": ["{options.outputFile}"],
      "options": {
        "cwd": "apps/api",
        "command": "eslint .",
        "max-warnings": 0
      }
    },
    "crap-score": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/crap-score/run.mjs apps/api"
      }
    },
    "reencrypt-card-keys": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/api/scripts/reencrypt-card-keys.mjs"
      }
    },
    "seed-dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/api/scripts/seed-dev-user.mjs"
      }
    },
    "test-scripts": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        {
          "runtime": "node -p \"process.platform + '-' + process.arch + '-' + process.version\""
        }
      ],
      "outputs": [],
      "options": {
        "command": "node --test apps/api/scripts/*.test.mjs"
      }
    }
  }
}
