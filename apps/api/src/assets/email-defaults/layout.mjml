<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.5" color="#202B30" />
      <mj-button
        background-color="#256D7B"
        color="#FFFFFF"
        font-size="16px"
        font-weight="bold"
        padding="12px 30px"
        border-radius="6px"
        text-decoration="none"
      />
    </mj-attributes>
    <mj-style>
      a { color: #256D7B; text-decoration: none; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#FFFFFF" width="600px">
    <mj-section background-color="#FFFFFF" padding="24px 0 16px 0">
      <mj-column>
        <mj-image
          src="{{host.logoUrl}}"
          width="200px"
          href="https://attraccess.org"
          alt="Attraccess"
          padding="0"
        />
      </mj-column>
    </mj-section>

    <mj-section padding="0">
      <mj-column>
        <mj-divider border-color="#D6DEDE" border-width="1px" />
      </mj-column>
    </mj-section>

    {{content}}

    <mj-section padding="0">
      <mj-column>
        <mj-divider border-color="#D6DEDE" border-width="1px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="16px 20px">
      <mj-column>
        <mj-text font-size="12px" color="#536369" align="center" padding="0">
          <a href="https://attraccess.org" style="color:#536369;">attraccess.org</a>
          &nbsp;·&nbsp;
          <a href="{{host.frontend}}" style="color:#536369;">{{host.frontend}}</a>
          &nbsp;·&nbsp;
          <a href="{{host.notificationPreferencesUrl}}" style="color:#536369;">Notification preferences</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
