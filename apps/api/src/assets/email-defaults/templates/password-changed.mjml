<mj-section background-color="#FFFFFF" padding="32px 20px 24px 20px">
  <mj-column>
    <mj-text padding="0 0 12px 0">{{t 'greeting' 'Hello {name},' name=user.username}}</mj-text>
    <mj-text padding="0 0 12px 0">
      {{t 'body' 'This is a confirmation that the password for your account ({email}) has been changed.' email=user.email}}
    </mj-text>
    <mj-text font-size="13px" color="#9CA3AF" padding="0">
      {{t 'footer' 'If you did not make this change, please reset your password immediately and contact support.'}}
    </mj-text>
  </mj-column>
</mj-section>
