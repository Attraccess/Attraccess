<mj-section background-color="#FFFFFF" padding="32px 20px 24px 20px">
  <mj-column>
    <mj-text padding="0 0 12px 0">{{t 'greeting' 'Hello'}} {{user.username}},</mj-text>
    <mj-text padding="0 0 24px 0">
      {{inviter.username}} {{t 'body_invited' 'has invited you to join the project'}} <strong>{{project.name}}</strong> {{t 'body_as' 'as'}} <strong>{{invitation.role}}</strong>.
    </mj-text>
    <mj-button href="{{invitationUrl}}" align="center">{{t 'button' 'View Invitation'}}</mj-button>
    <mj-text font-size="13px" color="#6B7280" padding="20px 0 0 0">
      {{t 'invitation_id' 'Invitation ID:'}} {{invitation.id}}
    </mj-text>
  </mj-column>
</mj-section>
