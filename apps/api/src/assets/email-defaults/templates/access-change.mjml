<mj-section background-color="#FFFFFF" padding="32px 20px 24px 20px">
  <mj-column>
    <mj-text padding="0 0 12px 0">{{t 'greeting' 'Hello'}} {{user.username}},</mj-text>
    <mj-text padding="0 0 12px 0">{{accessChange.body}}</mj-text>
    {{#if accessChange.url}}
    <mj-button href="{{accessChange.url}}" align="center">{{t 'button' 'View Details'}}</mj-button>
    <mj-text font-size="13px" color="#6B7280" padding="20px 0 0 0">
      {{t 'copy_link' 'Or copy this link into your browser:'}}<br /><a href="{{accessChange.url}}">{{accessChange.url}}</a>
    </mj-text>
    {{/if}}
    <mj-text font-size="12px" color="#9CA3AF" padding="16px 0 0 0">
      {{t 'footer' 'You received this email because access-change notifications are enabled for your account.'}}
    </mj-text>
  </mj-column>
</mj-section>
