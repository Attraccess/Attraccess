<mj-section background-color="#FFFFFF" padding="32px 20px 24px 20px">
  <mj-column>
    <mj-text padding="0 0 12px 0">{{t 'greeting' 'Hello'}} {{user.username}},</mj-text>
    <mj-text padding="0 0 24px 0">
      {{t 'body' 'Please verify your email address to activate your Attraccess account.'}}
    </mj-text>
    <mj-button href="{{url}}" align="center">{{t 'button' 'Verify Email'}}</mj-button>
    <mj-text font-size="13px" color="#6B7280" padding="20px 0 0 0">
      {{t 'copy_link' 'Or copy this link into your browser:'}}<br /><a href="{{url}}">{{url}}</a>
    </mj-text>
    <mj-text font-size="13px" color="#9CA3AF" padding="16px 0 0 0">
      {{t 'footer' 'If you did not create an account, you can safely ignore this email.'}}
    </mj-text>
  </mj-column>
</mj-section>
