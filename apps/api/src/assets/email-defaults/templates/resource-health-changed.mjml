<mj-section background-color="#FFFFFF" padding="32px 20px 24px 20px">
  <mj-column>
    <mj-text padding="0 0 12px 0">{{t 'greeting' 'Hello'}} {{user.username}},</mj-text>
    <mj-text padding="0 0 12px 0">
      {{t 'body_resource_prefix' 'Resource'}} <strong>{{resource.name}}</strong> {{health.bodyAction}}.
    </mj-text>
    {{#if health.identifier}}
    <mj-text font-size="14px" color="#4B5563" padding="0 0 4px 0">{{t 'subsystem_label' 'Subsystem:'}} <strong>{{health.identifier}}</strong></mj-text>
    {{/if}}
    <mj-text font-size="14px" color="#4B5563" padding="0 0 12px 0">
      {{t 'previous_status' 'Previous status:'}} <strong>{{health.previousStatus}}</strong><br/>
      {{t 'new_status' 'New status:'}} <strong>{{health.status}}</strong>
    </mj-text>
    {{#if health.reason}}
    <mj-text font-size="14px" color="#4B5563" padding="0 0 12px 0">{{t 'reason_label' 'Reason:'}} {{health.reason}}</mj-text>
    {{/if}}
    <mj-button href="{{resource.url}}" align="center">{{t 'button' 'Open Resource'}}</mj-button>
    <mj-text font-size="13px" color="#6B7280" padding="20px 0 0 0">
      {{t 'copy_link' 'Or copy this link into your browser:'}}<br /><a href="{{resource.url}}">{{resource.url}}</a>
    </mj-text>
    <mj-text font-size="12px" color="#9CA3AF" padding="16px 0 0 0">
      {{t 'footer' 'You received this email because you can manage this resource.'}}
    </mj-text>
  </mj-column>
</mj-section>
