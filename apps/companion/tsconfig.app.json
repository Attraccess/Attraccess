{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out",
    "rootDir": "./src",
    "module": "commonjs",
    "target": "es2022",
    "types": ["node"],
    "importHelpers": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "out", "dist", "**/*.spec.ts"]
}
