{
  "name": "attractap-nfc-emulator",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/attractap/nfc-emulator",
  "projectType": "application",
  "tags": ["scope:attractap", "type:firmware"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/idf.sh build",
        "cwd": "apps/attractap/nfc-emulator"
      },
      "outputs": ["{projectRoot}/build"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/test-host.sh",
        "cwd": "apps/attractap/nfc-emulator"
      },
      "cache": true
    },
    "flash": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/idf.sh flash",
        "cwd": "apps/attractap/nfc-emulator"
      },
      "cache": false
    },
    "monitor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/idf.sh monitor",
        "cwd": "apps/attractap/nfc-emulator"
      },
      "cache": false
    }
  }
}
