# Development overlay (successor of the attractap-touch-debug PlatformIO env):
#   idf.py -B build/dbg -DATTRACTAP_VARIANT=attractap-touch \
#          -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.debug" build
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# Observability (PERFORMANCE_ANALYSIS.md Q10): task high-water-marks + run-time
# stats via vTaskList/vTaskGetRunTimeStats in the monitor.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
