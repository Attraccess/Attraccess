{
  "name": "attractap-firmware",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/attractap/firmware",
  "projectType": "application",
  "tags": [
    "scope:hardware"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/attractap/firmware && python3 build_firmwares.py",
        "cwd": "."
      },
      "outputs": [
        "{projectRoot}/firmware_output"
      ],
      "inputs": [
        "{projectRoot}/CMakeLists.txt",
        "{projectRoot}/main/**/*",
        "{projectRoot}/variants/**/*",
        "{projectRoot}/sdkconfig.defaults",
        "{projectRoot}/sdkconfig.secure",
        "{projectRoot}/secure-version-floor.txt",
        "{projectRoot}/version.txt",
        "{projectRoot}/partitions.csv",
        "{projectRoot}/include/**/*",
        "{projectRoot}/*.py",
        "{projectRoot}/tools/**/*",
        "{projectRoot}/src/**/*",
        "{projectRoot}/esp-idf-version.txt"
      ],
      "cache": true
    },
    "build-lab": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/attractap/firmware && python3 build_firmwares.py --lab",
        "cwd": "."
      },
      "outputs": [
        "{projectRoot}/firmware_output_lab"
      ],
      "inputs": [
        "{projectRoot}/CMakeLists.txt",
        "{projectRoot}/main/**/*",
        "{projectRoot}/variants/**/*",
        "{projectRoot}/sdkconfig.defaults",
        "{projectRoot}/version.txt",
        "{projectRoot}/partitions.csv",
        "{projectRoot}/include/**/*",
        "{projectRoot}/*.py",
        "{projectRoot}/tools/**/*",
        "{projectRoot}/src/**/*",
        "{projectRoot}/esp-idf-version.txt",
        "{projectRoot}/park/**/*"
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "python3 -I apps/attractap/firmware/tools/test_check_secure_profile.py",
          "python3 -I apps/attractap/firmware/tools/test_secure_profile_flag.py",
          "python3 -I apps/attractap/firmware/tools/test_secure_lab_reader.py",
          "cmake -S apps/attractap/firmware/tests/supervision -B apps/attractap/firmware/tests/supervision/build",
          "cmake --build apps/attractap/firmware/tests/supervision/build",
          "ctest --test-dir apps/attractap/firmware/tests/supervision/build --output-on-failure",
          "cmake -S apps/attractap/firmware/tests/display-theme -B apps/attractap/firmware/tests/display-theme/build",
          "cmake --build apps/attractap/firmware/tests/display-theme/build --parallel 2",
          "ctest --test-dir apps/attractap/firmware/tests/display-theme/build --output-on-failure",
          "cmake -S apps/attractap/firmware/tests/lvgl-memory -B apps/attractap/firmware/tests/lvgl-memory/build",
          "cmake --build apps/attractap/firmware/tests/lvgl-memory/build --parallel 2",
          "ctest --test-dir apps/attractap/firmware/tests/lvgl-memory/build --output-on-failure",
          "cmake -S apps/attractap/firmware/tests/led-pattern -B apps/attractap/firmware/tests/led-pattern/build",
          "cmake --build apps/attractap/firmware/tests/led-pattern/build",
          "ctest --test-dir apps/attractap/firmware/tests/led-pattern/build --output-on-failure",
          "cmake -S apps/attractap/firmware/tests/websocket -B apps/attractap/firmware/tests/websocket/build",
          "cmake --build apps/attractap/firmware/tests/websocket/build",
          "ctest --test-dir apps/attractap/firmware/tests/websocket/build --output-on-failure",
          "cmake -S apps/attractap/firmware/tests/pairing -B apps/attractap/firmware/tests/pairing/build",
          "cmake --build apps/attractap/firmware/tests/pairing/build --parallel 4",
          "ctest --test-dir apps/attractap/firmware/tests/pairing/build --output-on-failure",
          "cmake -S apps/attractap/firmware/tests/ota -B apps/attractap/firmware/tests/ota/build",
          "cmake --build apps/attractap/firmware/tests/ota/build",
          "ctest --test-dir apps/attractap/firmware/tests/ota/build --output-on-failure",
          "cmake -S apps/attractap/firmware/tests/test-hooks -B apps/attractap/firmware/tests/test-hooks/build",
          "cmake --build apps/attractap/firmware/tests/test-hooks/build --parallel 2",
          "ctest --test-dir apps/attractap/firmware/tests/test-hooks/build --output-on-failure",
          "node --test apps/attractap/firmware/tests/ota/hardware-soak.test.mjs"
        ],
        "parallel": false,
        "cwd": "."
      },
      "cache": false
    },
    "flash": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/attractap/firmware && python3 flash_firmware.py",
        "cwd": "."
      },
      "cache": false
    },
    "setup-toolchain": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash apps/attractap/firmware/tools/setup-esp-idf.sh"
      }
    },
    "check-version": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/attractap/firmware/tools/check-version.mjs"
      }
    },
    "crap-score": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/crap-score/run.mjs apps/attractap/firmware"
      }
    }
  }
}
