{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": [
      "./node_modules/@types",
      "../../../../node_modules/@types"
    ]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
