{
  "name": "attractap-touch-p4-pcb",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/attractap/hardware/touch-p4",
  "projectType": "application",
  "tags": ["scope:hardware", "type:pcb"],
  "targets": {
    "setup-toolchain": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/setup-toolchain.sh"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/scripts/**/*", "{workspaceRoot}/docs/en/hardware/touch-p4/release.md"],
      "options": {
        "command": "python3 -I apps/attractap/hardware/touch-p4/scripts/bootstrap/test_design.py"
      }
    },
    "erc": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "inputs": ["{projectRoot}/kicad/**/*", "{projectRoot}/tools/**/*"],
      "outputs": ["{projectRoot}/fab/reports/erc.rpt"],
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh erc"
      }
    },
    "check-netlist": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "inputs": ["{projectRoot}/kicad/**/*", "{projectRoot}/tools/**/*", "{projectRoot}/scripts/bootstrap/**/*"],
      "outputs": ["{projectRoot}/fab/reports/schematic.net"],
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh check-netlist"
      }
    },
    "drc": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "inputs": ["{projectRoot}/kicad/**/*", "{projectRoot}/tools/**/*"],
      "outputs": ["{projectRoot}/fab/reports/drc.rpt"],
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh drc"
      }
    },
    "check-package": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh check-package"
      }
    },
    "check-source": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/kicad/**/*", "{projectRoot}/scripts/**/*"],
      "options": {
        "command": "python3 -I apps/attractap/hardware/touch-p4/scripts/check_source.py"
      }
    },
    "check-footprints": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh check-footprints"
      }
    },
    "simulate": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "inputs": ["{projectRoot}/kicad/**/*", "{projectRoot}/tools/**/*", "{projectRoot}/sim/**/*", "{projectRoot}/scripts/bootstrap/**/*"],
      "outputs": ["{projectRoot}/fab/reports/simulation.txt"],
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh simulate"
      }
    },
    "simulate-antenna": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh simulate-antenna"
      }
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["test", "check-source", "erc", "check-netlist", "drc", "simulate", "check-package"]
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "dependsOn": ["erc", "drc"],
      "inputs": ["{projectRoot}/kicad/**/*", "{projectRoot}/tools/**/*", "{projectRoot}/scripts/export_fab.py"],
      "outputs": [
        "{projectRoot}/fab/gerbers",
        "{projectRoot}/fab/jlcpcb",
        "{workspaceRoot}/docs/_media/hardware/touch-p4/schematic.pdf",
        "{workspaceRoot}/docs/_media/hardware/touch-p4/board-front.pdf",
        "{workspaceRoot}/docs/_media/hardware/touch-p4/board-back.pdf",
        "{projectRoot}/fab/*.csv"
      ],
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh export"
      }
    },
    "render": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "inputs": ["{projectRoot}/kicad/**/*", "{projectRoot}/tools/**/*"],
      "outputs": ["{workspaceRoot}/docs/_media/hardware/touch-p4/board-top.png", "{workspaceRoot}/docs/_media/hardware/touch-p4/board-bottom.png"],
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh render"
      }
    },
    "generate-library": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh generate-library"
      }
    },
    "generate-schematic": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh generate-schematic"
      }
    },
    "place": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh place"
      }
    },
    "route": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh route"
      }
    },
    "route-finish": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash apps/attractap/hardware/touch-p4/tools/pcb.sh route-finish"
      }
    }
  }
}
