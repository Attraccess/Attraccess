	(text "Power input"
		(exclude_from_sim no)
		(at 12 15 0)
		(effects (font (size 4 4) (bold yes)) (justify left bottom))
		(uuid "a3e71b04-898e-5f11-8370-e8e2f05b633e")
	)
	(text "USB-C, DC and PoE inputs, supply OR-ing, 3.3 V buck converter"
		(exclude_from_sim no)
		(at 11.43 21 0)
		(effects (font (size 2 2)) (justify left bottom))
		(uuid "6be24ddd-4a85-5ef5-ab48-3cdc05bd537f")
	)
	(text "Supply: USB-C 5 V, DC 12 to 24 V (barrel jack or spring terminal) or PoE (802.3af, isolated module)."
		(exclude_from_sim no)
		(at 11.43 27 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "6dce709c-7e15-5fac-b46e-f3271062af58")
	)
	(text "All three end on the +5V rail through blocking switches (U105 eFuse; U106/Q101, U107/Q102 ideal diodes),"
		(exclude_from_sim no)
		(at 11.43 29.8 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "70b4262a-9817-5976-91b9-db916257dded")
	)
	(text "so any combination may be connected: the highest one feeds the board, none feeds another back."
		(exclude_from_sim no)
		(at 11.43 32.6 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "fdaf4d20-3b1a-546a-8f01-6b4a263750ae")
	)
	(text "R104 / R105 take up the switches' leakage (microamps), so an unpowered input stays at 0 V."
		(exclude_from_sim no)
		(at 11.43 35.4 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "7cc7d191-2773-56c6-95d6-126699317b0d")
	)
	(text "USB: U105 starts the rail at 0.9 V/ms (C118), limits at 2 A (R110), off below 3.9 V and above 5.8 V."
		(exclude_from_sim no)
		(at 11.43 38.2 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "09d13dd9-76e6-51b6-887a-5a670aac36c5")
	)
	(text "DC input: C117 - L103 - C112/C113 filter the converter ripple off the supply cable; C120 damps a live"
		(exclude_from_sim no)
		(at 11.43 41 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "ddf8d8aa-b969-512a-b97e-8f8cd531e71c")
	)
	(text "plug-in; D106 clamps surges behind L103. U104 starts at 8.5 to 9.4 V (R103/R113)."
		(exclude_from_sim no)
		(at 11.43 43.8 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "be52a10b-86ee-5464-9aae-305c8c39891d")
	)
	(text "Do not add capacitance across the PoE input (POE_VPF / POE_VNF): it would break PoE detection."
		(exclude_from_sim no)
		(at 11.43 46.6 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "59829a6d-d59c-5ea0-a602-e584229aaaa2")
	)
	(text "The PoE module needs a minimum load: 100 mA (DP9900M) or 200 mA (Ag9905M)."
		(exclude_from_sim no)
		(at 11.43 49.4 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "cf6df4be-c9a5-5706-8b89-008e321a23e5")
	)
	(text "48 V side (primary)"
		(exclude_from_sim no)
		(at 41.91 302.26 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "ee472a90-49ea-5f4b-abab-37c4f87fecfb")
	)
	(text "isolated 5 V side"
