	(text "Power input"
		(exclude_from_sim no)
		(at 12 15 0)
		(effects (font (size 4 4) (bold yes)) (justify left bottom))
		(uuid "a3e71b04-898e-5f11-8370-e8e2f05b633e")
	)
	(text "USB-C, DC and PoE inputs, supply OR-ing, 3.3 V buck converter"
		(exclude_from_sim no)
		(at 11.43 21 0)
		(effects (font (size 2 2)) (justify left bottom))
		(uuid "6be24ddd-4a85-5ef5-ab48-3cdc05bd537f")
	)
	(text "Supply: USB-C 5 V, DC 12 to 24 V (barrel jack or spring terminal) or PoE (802.3af, isolated module)."
		(exclude_from_sim no)
		(at 11.43 27 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "6dce709c-7e15-5fac-b46e-f3271062af58")
	)
	(text "All three end on the +5V rail through Schottky diodes, so any combination may be connected."
		(exclude_from_sim no)
		(at 11.43 29.8 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "750c9ca2-e74b-5eb4-92e3-30db89cf868a")
	)
	(text "R104 / R105 take up the leakage of those diodes, so an unpowered input stays at 0 V."
		(exclude_from_sim no)
		(at 11.43 32.6 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "db952702-4616-5a63-ad1e-b988304039d8")
	)
	(text "DC input: C117 - L103 - C112/C113 filter the converter ripple off the supply cable; D106 clamps behind L103."
		(exclude_from_sim no)
		(at 11.43 35.4 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "a3594030-0341-5654-a53e-268aa57f85f7")
	)
	(text "Do not add capacitance across the PoE input (POE_VPF / POE_VNF): it would break PoE detection."
		(exclude_from_sim no)
		(at 11.43 38.2 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "963d972c-4180-5212-b239-3202f1b5bd70")
	)
	(text "The PoE module needs a minimum load: 100 mA (DP9900M) or 200 mA (Ag9905M)."
		(exclude_from_sim no)
		(at 11.43 41 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "be8251b7-c89a-51a1-96c0-675fa6babece")
	)
