	(text "Addressable RGB LEDs, level shifter, buzzer driver, tamper sensors"
		(exclude_from_sim no)
		(at 11.43 21 0)
		(effects (font (size 2 2)) (justify left bottom))
		(uuid "a8704e11-5b35-56a0-80ac-636ad178ce52")
	)
	(text "16 reverse-mount LEDs in a ring, shining through the board. Data: D701 -> D708, D710 -> D717."
		(exclude_from_sim no)
		(at 11.43 27 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "a07b91d7-7029-5291-898e-8f73ab51feb9")
	)
	(text "Buzzer: drive BUZZER with a 2.7 kHz square wave (LEDC). Its coil is between pads 1 and 2;"
		(exclude_from_sim no)
		(at 11.43 29.8 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "de2ce924-6a14-5779-87f5-a13539901b61")
	)
	(text "pads 3 and 4 only hold the part. R705 keeps the LED data line low while the MCU is in reset."
		(exclude_from_sim no)
		(at 11.43 32.6 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "cf1c75fd-08a1-5ebb-a928-f5246e29b081")
	)
	(text "LED supply: U705 limits the ring to 255 to 334 mA (R ILIM 91 k); its enable is tied on."
		(exclude_from_sim no)
		(at 11.43 35.4 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "77fe88df-763f-5c5a-965e-32db042703e6")
	)
	(text "R709 / C727 keep the NFC carrier off D707's data input, where the data line crosses the gap round the loop."
		(exclude_from_sim no)
		(at 11.43 38.2 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "864cba97-e84d-5a2d-b699-9a19d92b83a2")
	)
