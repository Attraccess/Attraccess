	(text "ESP32-C5-MINI-1 co-processor (esp-hosted over SDIO) and its 3.3 V converter"
		(exclude_from_sim no)
		(at 11.43 21 0)
		(effects (font (size 2 2)) (justify left bottom))
		(uuid "f9aa41b3-3ee3-579e-8e3c-dc08e498e76a")
	)
	(text "The C5 runs the esp-hosted co-processor firmware. First flash through the C5 test points (C5_TX, C5_RX,"
		(exclude_from_sim no)
		(at 11.43 27 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "7da832cb-231f-5cbe-8ab4-3ae1e48a9448")
	)
	(text "C5_EN, GND; C5_BOOT = IO28 held low at reset), later updates over SDIO from the ESP32-P4. Its USB pins"
		(exclude_from_sim no)
		(at 11.43 29.8 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "21eba3d6-9b21-57d6-84c6-39f6a6f76df2")
	)
	(text "carry SDIO D2/D3, so these test points are the only wired way in."
		(exclude_from_sim no)
		(at 11.43 32.6 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "e5cedb78-e25d-5fa7-8440-a07a24dcb5d2")
	)
	(text "SDIO uses the P4 SDMMC slot 0 pins: D0-D3 = GPIO39-42, CLK = GPIO43, CMD = GPIO44."
		(exclude_from_sim no)
		(at 11.43 35.4 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "ff0df1b2-1d5e-53c2-940a-20203885b292")
	)
	(text "The module's PCB antenna stands over the cut in the board's top edge: no copper and no metal near it."
		(exclude_from_sim no)
		(at 11.43 38.2 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "68be1da9-be1f-5493-bb30-98282d6e919b")
	)
	(text "U302 feeds only the module: always on with the 5 V rail; EN RC and all pull-ups on +3V3_WIFI."
		(exclude_from_sim no)
		(at 11.43 41 0)
