(version 1)
# The reverse-mount LEDs sit in windows cut into the board: their pads are closer to that edge
# than the general copper-to-edge rule allows.
(rule "PoE isolation"
  (condition "A.NetClass == 'PoE' && B.NetClass != 'PoE' && B.NetName != '' && B.NetName != 'unconnected-*' && !B.memberOfFootprint('C102')")
  (constraint clearance (min 2mm)))
# the USB-C receptacle has 0.1 mm between its own VBUS and GND pads
(rule "USB-C pad spacing"
  (condition "A.memberOfFootprint('J101') && B.memberOfFootprint('J101')")
  (constraint clearance (min 0.09mm)))
(rule "LED window"
  (condition "A.memberOfFootprint('D70?')")
  (constraint edge_clearance (min 0.12mm)))
