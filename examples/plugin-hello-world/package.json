{
  "name": "@attraccess-example/plugin-hello-world",
  "version": "1.0.0",
  "private": true,
  "description": "Working Attraccess npm plugin example: backend controller, event handler, and frontend route.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Attraccess/Attraccess.git",
    "directory": "examples/plugin-hello-world"
  },
  "homepage": "https://attraccess.org",
  "scripts": {
    "build": "node build.mjs",
    "pack-test": "pnpm --dir=../.. exec nx run plugins-backend-sdk:build && npm run build && ATTRACCESS_PLUGIN_TEST_HOST_VERSION=1.11.0 node ../../apps/plugins/scripts/verify-packed-plugin.mjs package package.json dist/index.js frontend/remoteEntry.js frontend/style.css"
  },
  "keywords": [
    "attraccess-plugin",
    "attraccess",
    "example"
  ],
  "files": [
    "dist",
    "frontend",
    "plugin.json"
  ],
  "peerDependencies": {
    "@attraccess/plugins-backend-sdk": "^1.11.0",
    "@attraccess/plugins-frontend-sdk": "^1.11.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0"
  },
  "attraccess": {
    "displayName": "Hello World",
    "description": "Example Attraccess plugin.",
    "host": "^1.11.0",
    "backend": "dist/index.js",
    "frontend": "frontend/remoteEntry.js",
    "styles": "frontend/style.css",
    "permissions": [
      "READ_USERS",
      "LISTEN_EVENTS",
      "ACCESS_MQTT_SERVERS",
      "TRIGGER_FLOWS"
    ],
    "sdk": {
      "backend": "^1.11.0",
      "frontend": "^1.11.0"
    },
    "persistence": {
      "contractVersion": 2,
      "supportedBackends": [
        "sqlite"
      ]
    }
  },
  "devDependencies": {
    "@attraccess/plugins-backend-sdk": "^1.11.0",
    "@attraccess/plugins-frontend-sdk": "^1.11.0",
    "@heroui/react": "^3.0.4",
    "@heroui/styles": "^3.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@originjs/vite-plugin-federation": "^1.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "esbuild": "^0.28.0",
    "lucide-react": "^1.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^5.0.0"
  }
}
