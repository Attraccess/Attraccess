# CI Dockerfile only needs: dist/, deploy/api/, docs/, entrypoint.sh
# Exclude everything else to keep context small
.git
.nx
node_modules
# Exclude workspace node_modules but keep deploy/api/node_modules (production deps)
!deploy/api/node_modules
apps
libs
tools
patches
coverage
**/coverage
**/*.spec.ts
**/*.test.ts
*.log
.vscode
.idea
.cursor
