{
  "name": "generators",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/generators/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": [
    "frontend",
    "companion",
    "ui",
    "plugins-frontend-ui",
    "plugins-frontend-sdk",
    "plugin-shelly",
    "plugin-rabbitmq",
    "plugin-wago"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": [],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/tools/generators",
        "main": "tools/generators/src/index.ts",
        "tsConfig": "tools/generators/tsconfig.lib.json",
        "assets": [
          "tools/generators/*.md",
          {
            "input": "./tools/generators/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./tools/generators/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./tools/generators",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./tools/generators",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    }
  }
}
