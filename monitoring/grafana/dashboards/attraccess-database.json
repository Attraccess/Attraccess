{
  "annotations": {
    "list": []
  },
  "description": "Database query performance: per-entity p95 latency, slow query counts, error rates, and per-method query throughput.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Per-Entity p95 Query Latency",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "custom": {
            "displayMode": "color-background"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (entity, method, le) (rate(attraccess_db_query_duration_seconds_bucket{job=\"attraccess\"}[5m])))",
          "legendFormat": "{{ entity }} {{ method }}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "title": "Slow Query Count (last 1h)",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "custom": {
            "displayMode": "color-background"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (entity, method) (increase(attraccess_db_slow_queries_total{job=\"attraccess\"}[1h]))",
          "legendFormat": "{{ entity }} {{ method }}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "title": "Query Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (entity, method, error_type) (rate(attraccess_db_query_errors_total{job=\"attraccess\"}[5m]))",
          "legendFormat": "{{ entity }} {{ method }} {{ error_type }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Top 10 Query Rate (entity+method)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(10, sum by (entity, method) (rate(attraccess_db_query_duration_seconds_count{job=\"attraccess\"}[5m])))",
          "legendFormat": "{{ entity }} {{ method }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Query Latency p50/p95/p99",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(attraccess_db_query_duration_seconds_bucket{job=\"attraccess\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(attraccess_db_query_duration_seconds_bucket{job=\"attraccess\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(attraccess_db_query_duration_seconds_bucket{job=\"attraccess\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Total Queries/sec",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(attraccess_db_query_duration_seconds_count{job=\"attraccess\"}[5m]))",
          "legendFormat": "queries/s",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Slow Queries/sec",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(attraccess_db_slow_queries_total{job=\"attraccess\"}[5m]))",
          "legendFormat": "slow/s",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Connection Pool Size",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "attraccess_db_pool_size{job=\"attraccess\"}",
          "legendFormat": "pool",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["attraccess", "performance", "database"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Attraccess Database",
  "uid": "attraccess-database",
  "version": 1
}
