        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(attraccess_http_requests_total{job=\"attraccess\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(attraccess_http_requests_total{job=\"attraccess\"}[5m])),1)",
          "legendFormat": "Error %"
        }
      ]
    },
