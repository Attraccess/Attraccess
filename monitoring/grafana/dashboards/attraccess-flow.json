{
  "annotations": {
    "list": []
  },
  "description": "Resource flow performance and activity: per-trigger throughput, success/failure mix, execution latency p50/p95/p99, and per-node-type latency.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Executions/sec by Trigger",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (trigger_type) (rate(attraccess_flow_executions_total{job=\"attraccess\"}[5m]))",
          "legendFormat": "{{ trigger_type }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Success/Failure Rate by Trigger",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (trigger_type, status) (rate(attraccess_flow_executions_total{job=\"attraccess\"}[5m]))",
          "legendFormat": "{{ trigger_type }} {{ status }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Execution Latency p50/p95/p99",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(attraccess_flow_execution_duration_seconds_bucket{job=\"attraccess\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(attraccess_flow_execution_duration_seconds_bucket{job=\"attraccess\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(attraccess_flow_execution_duration_seconds_bucket{job=\"attraccess\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Per-Trigger p95 Execution Duration",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "custom": {
            "displayMode": "color-background"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (trigger_type, le) (rate(attraccess_flow_execution_duration_seconds_bucket{job=\"attraccess\"}[5m])))",
          "legendFormat": "{{ trigger_type }}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "title": "Per-Node-Type p95 Duration",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          },
          "custom": {
            "displayMode": "color-background"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (node_type, le) (rate(attraccess_flow_node_duration_seconds_bucket{job=\"attraccess\"}[5m])))",
          "legendFormat": "{{ node_type }}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "title": "Top 10 Slowest Node Types (p95)",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal"
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (node_type, le) (rate(attraccess_flow_node_duration_seconds_bucket{job=\"attraccess\"}[15m]))))",
          "legendFormat": "{{ node_type }}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "title": "Total Executions (1h)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(attraccess_flow_executions_total{job=\"attraccess\"}[1h]))",
          "legendFormat": "executions/hr",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Failed Executions (1h)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(attraccess_flow_executions_total{job=\"attraccess\", status=\"failure\"}[1h]))",
          "legendFormat": "failures/hr",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Failure Ratio (5m)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "attraccess-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(attraccess_flow_executions_total{job=\"attraccess\", status=\"failure\"}[5m])) / clamp_min(sum(rate(attraccess_flow_executions_total{job=\"attraccess\"}[5m])), 1)",
          "legendFormat": "failure ratio",
          "refId": "A"
        }
      ]
    }
  ],
