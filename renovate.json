{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "docker-compose": {
    "managerFilePatterns": ["/(^|/)docker-compose\\.yml$/", "/(^|/)services\\.docker-compose\\.yml$/"]
  },
  "toolSettings": {
    "nodeMaxMemory": 1536
  },
  "packageRules": [
    {
      "description": "Workspace-only packages are not on the npm registry, so skip their lookups",
      "matchPackageNames": ["@attraccess/shared", "@attraccess/database-entities"],
      "enabled": false
    },
    {
      "description": "Group minor and patch dev dependency updates into one PR to save lockfile installs",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major dev dependencies"
    },
    {
      "description": "Group minor and patch runtime dependency updates into one PR to save lockfile installs",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major dependencies"
    },
    {
      "description": "Group all Docker image updates into a single PR",
      "matchDatasources": ["docker"],
      "groupName": "docker images"
    },
    {
      "description": "Node base image version is owned by .nvmrc, not Renovate",
      "matchDatasources": ["docker"],
      "matchDepNames": ["node"],
      "matchFileNames": ["Dockerfile", "tools/config-ui/Dockerfile", "tools/hetzner-dns-updater/Dockerfile"],
      "enabled": false
    },
    {
      "description": "Auto-merge patch-level Docker updates",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    }
  ]
}
