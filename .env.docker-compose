# Shared
TZ=Europe/Berlin

# Attraccess
AUTH_SESSION_SECRET=super-secret
LOG_LEVELS=error,warn,log,debug

#RabbitMQ
# User permissions that need to be set for users to be able to read and write to mqtt
# configure:    ^mqtt-subscription-.*$
# write:        ^(amq\.topic|mqtt-subscription-.*)$
# read:         ^(amq\.topic|mqtt-subscription-.*)$

# Duplicati
SETTINGS_ENCRYPTION_KEY=super-secure
DUPLICATI__WEBSERVICE_PASSWORD=password
DUPLICATI__WEBSERVICE_ALLOWED_HOSTNAMES=*

#Hetzner DNS Updater
HETZNER_DNS_UPDATER_ENABLED=FALSE
HETZNER_API_TOKEN=your-token
HETZNER_ZONE_ID=your-zone-id
HETZNER_RECORD_NAME=your-domain.record
HETZNER_TTL=60
# set this to set to a static fixed ip
HETZNER_FORCE_IP=

# Technitium DNS (opt-in via `docker compose --profile dns up -d`).
# DNS_SERVER_ADMIN_PASSWORD is required — compose refuses to start the
# dns profile when empty. DNS_SERVER_DOMAIN is the hostname Technitium
# advertises in its own SOA/NS records; the default is fine for
# local-only setups.
DNS_SERVER_DOMAIN=dns.attraccess.local
DNS_SERVER_ADMIN_PASSWORD=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=attraccess

# Config UI
# The config-ui sidecar rewrites Prometheus config. It refuses to
# start with an empty, short (<12 chars), or well-known password. Set a real
# value before `docker compose up`. For ephemeral dev you may override the
# check by setting CONFIG_UI_ALLOW_WEAK_PASSWORD=true.
CONFIG_UI_USERNAME=admin
CONFIG_UI_PASSWORD=
# CONFIG_UI_ALLOW_WEAK_PASSWORD=true

# fail2ban (opt-in via the `fail2ban` Compose profile)
# Linux only. macOS/Windows hosts: container runs but iptables bans are no-ops.
# Enable with: docker compose --profile fail2ban up -d
F2B_LOG_LEVEL=INFO
F2B_DB_PURGE_AGE=1d
F2B_IPTABLES_CHAIN=DOCKER-USER
# Auth-jail thresholds (seconds for time-based values).
F2B_ATTRACCESS_MAXRETRY=5
F2B_ATTRACCESS_FINDTIME=900
F2B_ATTRACCESS_BANTIME=900
