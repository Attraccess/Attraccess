#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
marker="$repo_root/.worktree-bootstrap-complete"

# post-checkout also runs for ordinary branch changes. Bootstrap only once in
# each worktree; a failed setup leaves no marker so the next checkout retries.
[ -f "$marker" ] && exit 0

printf '%s\n' 'Bootstrapping worktree dependencies...'
"$repo_root/scripts/setup-dev-dependencies.sh"
touch "$marker"
