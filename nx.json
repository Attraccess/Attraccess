{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.cjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/**/*.cy.[jt]s?(x)",
      "!{projectRoot}/cypress.config.[jt]s"
    ],
    "sharedGlobals": ["{workspaceRoot}/tools/vite/**/*", "{workspaceRoot}/tsconfig.base.json"],
    "testing": ["default", "{workspaceRoot}/jest.preset.js"],
    "swagger": ["default", "{projectRoot}/webpack.config.swagger.js"],
    "typeorm": ["default", "{projectRoot}/src/database/**/*"]
  },
  "tui": {
    "enabled": true
  },
  "plugins": [
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "exclude": ["apps/plugins/wago/cc100-runtime/**/*"]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "exclude": ["apps/api-e2e/**/*"]
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      }
    },
    {
      "plugin": "@nx/rollup/plugin",
      "options": {
        "buildTargetName": "build",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/react/router-plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "dev",
        "startTargetName": "start",
        "watchDepsTargetName": "watch-deps",
        "buildDepsTargetName": "build-deps"
      }
    }
  ],
  "targetDefaults": {
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "e2e-ci--**/*": {
      "dependsOn": ["^build"]
    },
    "publish": {
      "inputs": [
        "{workspaceRoot}/apps/plugins/scripts/publish-plugin.mjs",
        "{workspaceRoot}/apps/plugins/scripts/npm-dist-tag.mjs"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.cjs",
        "{projectRoot}/eslint.config.cjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "outputs": ["{options.outputFile}"]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "test": [
      {
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/jest.preset.js",
          {
            "externalDependencies": ["jest"]
          }
        ],
        "outputs": ["{workspaceRoot}/coverage/{projectRoot}/test"]
      },
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "options": {
          "env": {
            "NODE_OPTIONS": "--experimental-vm-modules",
            "TS_NODE_COMPILER_OPTIONS": "{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}"
          }
        }
      }
    ],
    "typecheck": {
      "cache": true,
      "dependsOn": ["generate", "^generate"],
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ]
    },
    "swagger-build": {
      "cache": true,
      "inputs": ["swagger", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/{projectName}-swagger"]
    },
    "export-swagger": {
      "cache": true,
      "dependsOn": ["swagger-build"],
      "outputs": ["{workspaceRoot}/dist/apps/{projectName}-swagger/swagger.json"]
    },
    "e2e": {
      "cache": true,
      "inputs": ["testing", "^production"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/e2e"]
    },
    "build-migration-datasource": {
      "cache": true,
      "inputs": ["typeorm", "^production"],
      "outputs": ["{options.outputPath}"]
    },
    "migration-generate": {
      "cache": true,
      "dependsOn": ["build-migration-datasource"],
      "outputs": ["{options.outputPath}"]
    },
    "migrations-run": {
      "cache": true,
      "dependsOn": ["build-migration-datasource"],
      "outputs": ["{options.outputPath}"]
    },
    "crap-score": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/scripts/crap-score/**/*",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/jest.config.*",
        "{workspaceRoot}/vitest.config.*",
        "{workspaceRoot}/vite.config.*",
        "{workspaceRoot}/babel.config.*",
        "{workspaceRoot}/.babelrc*",
        "{workspaceRoot}/.swcrc",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/patches/**/*",
        {
          "runtime": "node -p \"process.platform + '-' + process.arch + '-' + process.version + '-' + process.cwd()\""
        },
        {
          "dependentTasksOutputFiles": "**/coverage-final.json"
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/crap/{projectName}"]
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "tailwind",
        "linter": "eslint",
        "bundler": "vite"
      },
      "component": {
        "style": "tailwind"
      },
      "library": {
        "style": "tailwind",
        "linter": "eslint",
        "unitTestRunner": "vitest"
      }
    }
  },
  "release": {
    "projects": [
      "api",
      "frontend",
      "api-client",
      "application-models",
      "database-entities",
      "env",
      "plugins-backend-sdk",
      "plugins-frontend-sdk",
      "plugins-frontend-ui",
      "react-query-client",
      "@attraccess/source"
    ],
    "projectsRelationship": "fixed",
    "git": {
      "commit": true,
      "tag": true,
      "commitMessage": "chore(release): {version} [skip ci]"
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "preserveMatchingDependencyRanges": false
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      }
    }
  },
  "neverConnectToCloud": true,
  "analytics": false,
  "affected": {
    "legacy": true
  }
}
