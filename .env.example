AUTH_SESSION_SECRET=<super-secret-key>

ATTRACCESS_URL=http://localhost:3000
# set this if you need the aplication to receive callbacks from the public internet e.g. sumup and this is a different domain/ip/etc
# than what your users use to access attraccess (most setups wont need this)
#ATTRACCESS_PUBLIC_INTERNET_URL=https://public.domain.com

SMTP_SERVICE=SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=no-reply@localhost
SMTP_PASS=
SMTP_FROM=no-reply@localhost
SMTP_SECURE=false

# Comma-separated list of enabled log levels: error,warn,log,debug,verbose
LOG_LEVELS=error,warn,log

LICENSE_KEY=I AM USING THIS SOFTWARE ONLY FOR NON-PROFIT AND COMPLY TO ALL TERMS OF THE LICENSE.md at https://github.com/Attraccess/Attraccess/blob/main/LICENSE.md

STATIC_DOCS_FILE_PATH=./docs

# AI / Ollama Configuration
AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text