AUTH_SESSION_SECRET=<super-secret-key>

ATTRACCESS_URL=http://localhost:3000
# set this if you need the aplication to receive callbacks from the public internet e.g. sumup and this is a different domain/ip/etc
# than what your users use to access attraccess (most setups wont need this)
#ATTRACCESS_PUBLIC_INTERNET_URL=https://public.domain.com

# Reverse proxy: number of trusted proxy hops between the client and Attraccess, so auth
# rate limiting uses the real client IP instead of the proxy IP. Unset (default) trusts no
# proxy. Use 1 behind a single reverse proxy (nginx/Traefik/Caddy), 2 behind a CDN + proxy.
# Advanced: a comma-separated list of trusted proxy IPs/CIDRs, or one of loopback, linklocal,
# uniquelocal. Setting this larger than your real proxy chain lets clients spoof their IP.
#TRUST_PROXY=1

SMTP_SERVICE=SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=no-reply@localhost
SMTP_PASS=
SMTP_FROM=no-reply@localhost
SMTP_SECURE=false

# Comma-separated list of enabled log levels: error,warn,log,debug,verbose
LOG_LEVELS=error,warn,log

LICENSE_KEY=I AM USING THIS SOFTWARE ONLY FOR NON-PROFIT AND COMPLY TO ALL TERMS OF THE LICENSE.md at https://github.com/Attraccess/Attraccess/blob/main/LICENSE.md

STATIC_DOCS_FILE_PATH=./docs

# Grafana (only needed when running monitoring stack)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Config UI (manages dnsmasq + prometheus config)
# REQUIRED: the config-ui service refuses to start with an empty, short
# (<12 chars), or well-known password. Set a strong, unique value — this UI
# can rewrite DNS and Prometheus config.
# For ephemeral dev you can set CONFIG_UI_ALLOW_WEAK_PASSWORD=true to bypass.
CONFIG_UI_USERNAME=admin
CONFIG_UI_PASSWORD=
DNS_SERVER_ENABLED=FALSE