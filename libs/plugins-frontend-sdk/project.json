{
  "name": "plugins-frontend-sdk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/plugins-frontend-sdk/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:plugin-sdk"],
  "// targets": "to see all targets run: nx show project plugins-frontend-sdk --web",
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}",
        "registry": "https://registry.npmjs.org/",
        "access": "public"
      }
    },
    "crap-score": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/crap-score/run.mjs libs/plugins-frontend-sdk"
      }
    }
  }
}
