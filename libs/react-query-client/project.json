{
  "name": "react-query-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/react-query-client/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:core"],
  "// targets": "to see all targets run: nx show project react-query-client --web",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/libs/react-query-client",
        "tsConfig": "libs/react-query-client/tsconfig.lib.json",
        "packageJson": "libs/react-query-client/package.json",
        "main": "libs/react-query-client/src/index.ts",
        "assets": ["libs/react-query-client/*.md"]
      },
      "dependsOn": ["generate"]
    },
    "generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/dist/apps/api-swagger/swagger.json"],
      "outputs": ["{projectRoot}/src/lib/**/**"],
      "options": {
        "command": "pnpm openapi-rq --input=dist/apps/api-swagger/swagger.json --enums=typescript --initialPageParam=1 --output=libs/react-query-client/src/lib"
      },
      "dependsOn": ["api:export-swagger"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["generate"],
      "options": {
        "cwd": "libs/react-query-client",
        "command": "eslint . --max-warnings=0"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["generate"],
      "options": {
        "cwd": "libs/react-query-client",
        "command": "jest",
        "env": {
          "NODE_OPTIONS": "--experimental-vm-modules"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["generate"],
      "options": {
        "cwd": "libs/react-query-client",
        "command": "tsc --noEmit -p tsconfig.lib.json"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}",
        "registry": "https://registry.npmjs.org/",
        "access": "public"
      }
    },
    "crap-score": {
      "dependsOn": ["test"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/crap-score/run.mjs libs/react-query-client"
      }
    }
  }
}
