{
  "name": "@attraccess/plugins-backend-sdk",
  "version": "1.5.2",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.8.1",
    "@attraccess/database-entities": "*",
    "@nestjs/common": "^11.1.21",
    "rxjs": "^7.8.2",
    "@nestjs/core": "^11.1.21",
    "@nestjs/swagger": "^11.4.3",
    "express": "4.22.1",
    "@nestjs/passport": "^11.0.5"
  }
}
