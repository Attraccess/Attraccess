{
  "name": "@attraccess/plugins-backend-sdk",
  "version": "1.10.0",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    "./v2": {
      "types": "./src/v2.d.ts",
      "import": "./src/v2.js",
      "default": "./src/v2.js"
    },
    "./adapter": {
      "types": "./src/adapter.d.ts",
      "import": "./src/adapter.js",
      "default": "./src/adapter.js"
    },
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@attraccess/application-models": "*",
    "tslib": "^2.8.1",
    "@attraccess/database-entities": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/event-emitter": "^3.1.0",
    "rxjs": "^7.8.2",
    "@nestjs/core": "^11.1.0",
    "typeorm": "0.3.31",
    "@nestjs/swagger": "^11.2.0",
    "express": "4.22.3",
    "@nestjs/passport": "^11.0.5",
    "@attraccess/shared": "*"
  }
}
