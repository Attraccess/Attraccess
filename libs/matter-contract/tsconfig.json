{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "strictPropertyInitialization": true,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "importHelpers": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
