{
  "name": "env",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/env/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:core"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/env",
        "tsConfig": "libs/env/tsconfig.lib.json",
        "packageJson": "libs/env/package.json",
        "main": "libs/env/src/index.ts",
        "assets": ["libs/env/*.md"]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}",
        "access": "public"
      }
    },
    "crap-score": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/crap-score/run.mjs libs/env"
      }
    }
  }
}
