{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:core", "scope:ui"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/ui",
        "command": "tsc -p tsconfig.lib.json --noEmit"
      }
    },
    "lint": {
      "options": {
        "command": "eslint \"**/*.ts\" \"**/*.tsx\" --max-warnings=0"
      }
    },
    "crap-score": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/crap-score/run.mjs libs/ui"
      }
    }
  }
}
