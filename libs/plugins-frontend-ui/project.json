{
  "name": "plugins-frontend-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/plugins-frontend-ui/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project plugins-frontend-ui --web",
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}",
        "registry": "https://registry.npmjs.org/",
        "access": "public"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p libs/plugins-frontend-ui/tsconfig.spec.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p libs/plugins-frontend-ui/tsconfig.spec.json"
      }
    }
  }
}
